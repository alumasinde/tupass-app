NODE_ENV=development
APP_NAME="TuPass"

# MySQL 8.x / MariaDB. Special characters in the password must be URL-encoded.
DATABASE_URL="mysql://tupass:change-me@127.0.0.1:3306/tupass"

# Multi-tenancy
APP_BASE_DOMAIN="tupass.localhost"
# subdomain | domain | both
TENANT_HOST_MODE="both"

# debug | info | warn | error
LOG_LEVEL="info"
