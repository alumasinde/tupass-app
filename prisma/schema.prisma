generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// Phase 1 establishes the tenant-ready organization boundary.
/// Business modules are intentionally introduced in later phases.
model Organization {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("organizations")
}

/// Configurable identification document types.
model IdentificationType {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("identification_types")
}

/// Global user identity. Organization membership is deliberately separate
/// so a future user can belong to more than one organization.
model User {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  firstName     String   @map("first_name") @db.VarChar(100)
  lastName      String   @map("last_name") @db.VarChar(100)
  email         String?  @unique @db.VarChar(191)
  phone         String?  @unique @db.VarChar(30)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("users")
}
